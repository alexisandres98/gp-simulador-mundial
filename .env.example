# Variables de entorno de GP Simulador — COPIA a .env (no se commitea) y rellena.
# El backend las lee con process.env. En producción se setean en el dashboard de Render.
# Local: server.js auto-carga este .env si existe (zero-dep) → basta `npm start` o `node server.js`.

# ----- Fase 4: API-Football (fuente principal de data contextual) -----
# Sin esta key, la app cae a ESPN + datos manuales + modelo (no rompe).
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_LEAGUE=1
API_FOOTBALL_SEASON=2026

# Alias aceptado por si prefieres este nombre (equivalente a API_FOOTBALL_KEY):
# VITE_API_FOOTBALL_KEY=

# ----- Otras (opcionales en local; ya configuradas en Render) -----
# SIMS=10000
# ADMIN_EMAILS=alexisgomezico@gmail.com
# DB_FILE=/data/db.json
# RESEND_API_KEY=
# MAIL_FROM=codigo@gpsimulador.com
# MAIL_REPLY_TO=
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=

# ===== Sprint 0 — Plataforma de datos v2 (PostgreSQL). SIN VALORES REALES. =====
# Cadena de conexión a PostgreSQL. Sin ella, la app actual funciona igual y la capa v2 queda INERTE.
DATABASE_URL=
# SSL en la conexión (Render Postgres lo requiere → true en producción)
DB_SSL=true
# Tamaño máximo del pool de conexiones (nunca una conexión por request)
DB_POOL_MAX=10
# Timeout para adquirir conexión (ms)
DB_CONNECTION_TIMEOUT_MS=5000

# Feature flags (default: ambas en false = app actual intacta, sin escrituras, sin rutas nuevas).
MARKET_DATA_PLATFORM_V2=false
MARKET_DATA_WRITE_ENABLED=false

# Políticas de datos (opcionales; defaults en database/config.js).
# RAW_RETENTION_DAYS=365
# FRESHNESS_AGING_MS=60000
# FRESHNESS_STALE_MS=300000
# DB_MAX_PAYLOAD_BYTES=1000000
# DB_STATEMENT_TIMEOUT_MS=15000
# PLATFORM_LOG_DEBUG=false

# ===== Sprint 0.1 — GP Intelligence (V2 challenger, solo sandbox) =====
# Safety cap del ajuste contextual de Elo (barrera de seguridad, NO valor calibrado).
GP_INTELLIGENCE_MAX_ELO_ADJUSTMENT=55
# Caps por grupo (anti double-counting). Opcionales; defaults en gpIntelligence.js.
# GP_INTELLIGENCE_CAP_PERFORMANCE=40
# GP_INTELLIGENCE_CAP_SQUAD=35
# GP_INTELLIGENCE_CAP_LOAD=12
# Logging experimental de ejecuciones (requiere DATABASE_URL). Default false. NO activar aún.
GP_INTELLIGENCE_EXPERIMENT_LOGGING=false

# ===== Sprint 2 — Canonical Event Graph (shadow mode). Default todo apagado. =====
CANONICAL_GRAPH_ENABLED=false
CANONICAL_GRAPH_WRITE_ENABLED=false
CANONICAL_AUTO_MATCH_ENABLED=false
# Umbrales (0-100). Un hard conflict SIEMPRE prevalece sobre el score.
# CANONICAL_EVENT_MATCH_THRESHOLD=95
# CANONICAL_EVENT_REVIEW_THRESHOLD=75
# CANONICAL_MARKET_MATCH_THRESHOLD=95
# CANONICAL_MARKET_REVIEW_THRESHOLD=75
# CANONICAL_OUTCOME_MATCH_THRESHOLD=95
