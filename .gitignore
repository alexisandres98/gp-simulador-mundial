# Cierres de mercado de esports: se acumulan en el disco de Render, no en git.
# La base histórica AGREGADA de CS2 sí se versiona (unos 950 KB): es lo que el motor lee en producción y
# tiene que viajar con el código. El crudo (~90.000 mapas, 25 MB) vive en el disco persistente y se queda
# fuera — meterlo aquí repetiría el error que llevó los builds de clubes a 17 minutos.
data/esports/*
!data/esports/cs2/
data/esports/cs2-raw/

# crudo de esports: vive en el disco persistente (o local); jamás en git (25MB+)
/esports/
/nfl-raw/

# disco local del motor amfoot (en prod vive en /data/amfoot)
/amfoot/
