# Variables de entorno de GP Simulador — COPIA a .env (no se commitea) y rellena.
# El backend las lee con process.env. En producción se setean en el dashboard de Render.
# Local (Node >= 20.6, sin dependencias): node --env-file=.env server.js   ó   npm run start:local

# ----- Fase 4: API-Football (fuente principal de data contextual) -----
# Sin esta key, la app cae a ESPN + datos manuales + modelo (no rompe).
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_LEAGUE=1
API_FOOTBALL_SEASON=2026

# Alias aceptado por si prefieres este nombre (equivalente a API_FOOTBALL_KEY):
# VITE_API_FOOTBALL_KEY=

# ----- Otras (opcionales en local; ya configuradas en Render) -----
# SIMS=10000
# ADMIN_EMAILS=alexisgomezico@gmail.com
# DB_FILE=/data/db.json
# RESEND_API_KEY=
# MAIL_FROM=codigo@gpsimulador.com
# MAIL_REPLY_TO=
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_TOKEN=
