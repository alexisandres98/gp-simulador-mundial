# Datos grandes de clubes: viven en el disco persistente de Render (/data/clubs/), NO en git (deploy rápido)
data/clubs/player-history-*.json
data/clubs/results-*.json
data/clubs/fotmob-*.json
data/clubs/props-history-*.json
data/clubs/player-photos.json
data/clubs/af-team-map.json

# caché de páginas de Wikipedia del harvester de boxeo (25MB, solo acelera re-procesar)
data/combat/.boxing-cache.json

# Cierres de mercado de esports: se acumulan en el disco de Render, no en git.
# La base histórica AGREGADA de CS2 sí se versiona (unos 950 KB): es lo que el motor lee en producción y
# tiene que viajar con el código. El crudo (~90.000 mapas, 25 MB) vive en el disco persistente y se queda
# fuera — meterlo aquí repetiría el error que llevó los builds de clubes a 17 minutos.
data/esports/*
!data/esports/cs2/
!data/esports/lol/
!data/esports/valorant/
# el crudo PESADO de valorant (detalle por partido de vlr.gg) no entra en git: se agrega a archivos
# compactos que sí se versionan. series.json (índice liviano, es la base del Elo) SÍ se versiona.
data/esports/valorant/maps.json
data/esports/valorant/players-raw.json
# el estado plano de la cosecha de LoL (16 MB, cursor reanudable): lo que se versiona es el .gz que lee
# el motor. Se siembra desde el .gz cuando hay que rellenar campos y se vuelve a comprimir al terminar.
data/esports/lol/games.json
data/esports/lol/drafts.json
data/esports/lol/players.json
!data/esports/dota2/
# el crudo del Explorer de OpenDota (drafts ~1M filas, scoreboard ~500k) tampoco: se agrega compacto
data/esports/dota2/drafts.json
data/esports/dota2/players-raw.json
data/esports/cs2-raw/

# crudo de esports: vive en el disco persistente (o local); jamás en git (25MB+)
/esports/
/nfl-raw/

# disco local del motor amfoot (en prod vive en /data/amfoot)
/amfoot/
# artefactos locales de correr el server fuera de Render (en prod viven en /data/*)
/nfl/
data/fabric/
data/clubs/odds-archive/
data/tennis/disk/
data/f1/disk/

# cerrojo del rellenado de LoL: estado de proceso, no de datos
data/esports/lol/.kills-backfill.lock

# estado local del canal prop firm (en prod vive en /data/propfirm)
data/propfirm/
