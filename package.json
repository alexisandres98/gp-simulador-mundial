{
  "name": "worldcup-simulator",
  "version": "1.0.0",
  "description": "Simulador Monte Carlo del Mundial 2026 con probabilidades en tiempo real y arbitraje Polymarket/Kalshi",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db:migrate": "node database/migrate.js up",
    "db:status": "node database/migrate.js status",
    "db:rollback": "node database/migrate.js rollback",
    "platform:health": "node database/platform-health-cli.js",
    "test:gpi": "node tests/gp-intelligence.test.js",
    "test:db": "node tests/db-acceptance.test.js",
    "test:market-data": "node tests/market-data.test.js",
    "market-data:once": "node market-data/cli.js once",
    "market-data:status": "node market-data/cli.js status",
    "market-data:verify": "node market-data/cli.js verify"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
